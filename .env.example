# .env.example
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# Every value here has a safe default, so an empty .env still boots.

# ---- Runtime -------------------------------------------------------------
AZMUTH_ENV=development
# AZMUTH_HOME=            # override the project/data root (optional)

# ---- Logging -------------------------------------------------------------
AZMUTH_DEBUG=
AZMUTH_LOG_LEVEL=
AZMUTH_LOG_JSON=false
AZMUTH_LOG_TO_FILE=true
AZMUTH_LOG_TO_CONSOLE=

# ---- Language ------------------------------------------------------------
AZMUTH_DEFAULT_LANGUAGE=en
AZMUTH_EXTRA_LANGUAGES=

# ---- LLM provider --------------------------------------------------------
# "stub" is a development placeholder that echoes input. Real providers
# (openai_compatible, ollama, local) are registered in STEP 3.
LLM_PROVIDER=stub
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# ---- Search provider -----------------------------------------------------
SEARCH_PROVIDER=null
SEARCH_API_KEY=

# ---- Voice ---------------------------------------------------------------
STT_PROVIDER=null
TTS_PROVIDER=null
WAKE_WORD_PROVIDER=null
WAKE_WORD_PHRASE=azmuth

# ---- Memory --------------------------------------------------------------
MEMORY_BACKEND=sqlite
MEMORY_DATABASE=
EMBEDDING_PROVIDER=null

# ---- Security ------------------------------------------------------------
CREATOR_AUTH_METHOD=pin

# ---- Conversation / tasks ------------------------------------------------
SESSION_MAX_TURNS=20
SESSION_TTL_MINUTES=120
TASK_MAX_CONCURRENT=4


# ---- Ollama (local models) ----------------------------------------------
# Base URL of the Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MAX_LOADED_MODELS=1
# ---- NVIDIA NIM (free cloud tier) ---------------------------------------
# Get a key at https://build.nvidia.com/settings/api-keys
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=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

# ---- Model routing -------------------------------------------------------
# Default purpose when the caller does not specify one:
#   chat | coding | reasoning | fast | vision
LLM_DEFAULT_PURPOSE=chat

# Prefer a local model over a cloud one when both can serve a request.
LLM_PREFER_LOCAL=true

# ---- Groq (Primary Cloud LLM) -------------------------------------------
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=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

# ---- Google Gemini (Fallback Cloud LLM) ---------------------------------
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=AQ.Ab8RN6JFHRGu_c7njwu7nStJQsbFwfcgz2burA1v9RQFZ_JOmQ

# ---- Model Routing -------------------------------------------------------
# Prefer local models for coding and embeddings, cloud for chat/reasoning.
LLM_PREFER_LOCAL_FOR_CODING=true
LLM_PREFER_LOCAL_FOR_EMBEDDING=true